# URL del backend FastAPI. Vacío = sin backend (el sitio muestra estados «sin conexión»).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Pon "true" solo cuando el flujo de n8n (N8N_QUOTE_WEBHOOK del backend) esté conectado:
# activa la nota «este formulario es un flujo de n8n» en Servicios.
NEXT_PUBLIC_N8N_ENABLED=false

# Dominio público del sitio (sin barra final). Hace que la vista previa al compartir (LinkedIn, WhatsApp)
# apunte a la imagen correcta. Defínelo al publicar.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Subruta de publicación (GitHub Pages: /RUIDO). Déjala vacía en local o con dominio propio.
NEXT_PUBLIC_BASE_PATH=
