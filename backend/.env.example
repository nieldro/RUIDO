# Copia este archivo a .env para desarrollo local. NUNCA subas el .env real.

# --- Base de datos ---------------------------------------------------------
# Produccion: PostgreSQL (Railway/Fly la entregan como postgresql://...; se
# normaliza solo a postgresql+psycopg://). Local sin Postgres: SQLite.
DATABASE_URL=sqlite:///./portfolio_dev.db

# --- CORS ------------------------------------------------------------------
# Origenes permitidos, separados por coma.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100

# --- Privacidad / rate limit ----------------------------------------------
# Sal secreta para el HMAC de la IP (rate limit). Genera una larga y aleatoria:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Si la dejas vacia se genera una al arrancar (se pierde al reiniciar).
RATE_LIMIT_SALT=
# Cuantos proxies de confianza hay delante de la API (Railway/Fly = 1;
# si ademas hay un rewrite de Vercel por delante = 2).
TRUSTED_PROXY_HOPS=1
ASK_RATE_LIMIT=10
QUOTE_RATE_LIMIT=5

# --- GitHub ----------------------------------------------------------------
GITHUB_USER=nieldro
# Token de SOLO LECTURA (fine-grained: metadata + contents, solo lectura).
GITHUB_TOKEN=
# Secreto compartido del webhook (el mismo que pegas en GitHub).
GITHUB_WEBHOOK_SECRET=
# Refresco de respaldo cada hora. En pruebas se apaga.
ENABLE_SCHEDULER=true
REPOS_REFRESH_SECONDS=3600

# --- Chat "Preguntale a mi CV" ----------------------------------------------
# Sin clave el chat responde 503 {code: "llm_not_configured"}.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# --- Cotizador ---------------------------------------------------------------
# URL del Webhook de n8n. Vacia = el lead se guarda igual, notified=false.
N8N_QUOTE_WEBHOOK=
